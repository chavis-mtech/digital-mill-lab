# Digital Mill Lab - example configuration (NO real secrets here).
# Copy to .env for local overrides. All values below are safe demo defaults.

# Demo mode: true = public demo behaviour (simulated roles, session-scoped writes, rate limits).
DEMO_MODE=true
APP_ENV=development

# Database. Relative sqlite paths are resolved from the REPO ROOT (not the cwd).
# PostgreSQL example: postgresql+psycopg://dml:dml@localhost:5432/dml_demo
DATABASE_URL=sqlite:///data/demo.db

# Last day of the synthetic dataset (dataset window = DATASET_DAYS days ending here).
DEMO_ANCHOR=2026-11-20
DATASET_DAYS=120
MILL_TIMEZONE=Asia/Bangkok

# Rate limiting (token bucket, in-memory, per IP and per X-Demo-Session).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_IP_PER_MINUTE=240
RATE_LIMIT_PER_SESSION_PER_MINUTE=120
RATE_LIMIT_BURST=40
# Only set true when the API sits behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# How many trusted proxies APPEND to X-Forwarded-For in front of the API (counted from the right). Next.js rewrites do NOT append
# (verified, Next 16): browser -> Next.js -> API: keep TRUST_PROXY_HEADERS=false; browser -> nginx (appends) -> Next.js -> API: true + 1.
# See docs/DEPLOYMENT.md "Rate limiting behind proxies".
TRUSTED_PROXY_HOPS=1

# Copilot LLM adapter. "none" = deterministic no-API mode (default, ADR-010).
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=

# Request body cap for JSON endpoints (bytes). The CV upload route allows UPLOAD_MAX_BYTES + 1 MiB.
MAX_BODY_BYTES=262144

# Uploads (CV prototype). 5 MiB default.
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# CORS. In production the web app proxies /api/v1 (same origin), so this is only for local dev.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=INFO

# SQLite only: WAL journal + busy timeout (needed when several API worker processes share the file). Off by default because it
# rewrites the database file header; the Docker entrypoint sets it to true.
SQLITE_WAL=false

# POST /demo/reset-all clears every visitor's sandbox. Default: allowed in development/test, REFUSED when APP_ENV=demo|production.
# ALLOW_RESET_ALL=false
